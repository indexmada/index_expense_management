<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_jouranl_cashier">
        <t t-call="web.html_container">
            <!-- <t t-call="web.external_layout"> -->
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <h1 style="text-align: center;">Journal caisse du <t t-esc="doc.date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></h1>
                        <!-- <p><strong>Date du journal</strong> : <t t-esc="doc.date"/></p>
                        <p><strong>Référence du journal</strong> : <t t-esc="doc.journal_reference"/></p> -->
                        <div style="margin-bottom: 20px; text-align: right; font-size: 18px;"><strong>Solde initial</strong> : <t t-esc="doc.initial_balance" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></div>
                        <!-- <div style="margin-bottom: 20px; text-align: right; font-size: 18px;"><strong>Solde initial : </strong> <span t-field="doc.initial_balance" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></div> -->
                        
                        <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th style="background-color: #f2f2f2; text-align: left; padding: 8px;">Date</th>
                                    <th style="background-color: #f2f2f2; text-align: left; padding: 8px;">Libellé</th>
                                    <th style="background-color: #f2f2f2; text-align: left; padding: 8px;">Partenaire</th>
                                    <th style="background-color: #f2f2f2; text-align: left; padding: 8px;">Référence</th>
                                    <th style="background-color: #f2f2f2; text-align: left; padding: 8px;">Entrée</th>
                                    <th style="background-color: #f2f2f2; text-align: left; padding: 8px;">Sortie</th>
                                    <th style="background-color: #f2f2f2; text-align: left; padding: 8px;">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.journal_box_aggregate_ids" t-as="line">
                                    <tr>
                                        <td style="padding: 8px;"><t t-esc="line.date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></td>
                                        <td style="padding: 8px;"><t t-esc="line.label"/></td>
                                        <td style="padding: 8px;"><t t-esc="line.partner"/></td>
                                        <td style="padding: 8px;"><t t-esc="line.reference"/></td>
                                        <td style="padding: 8px;"><t t-esc="line.input" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td style="padding: 8px;"><t t-esc="line.output" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td style="padding: 8px;"><t t-esc="line.balance" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        
                        <div style="margin-top: 20px; text-align: right; font-size: 18px;"><strong>Solde final</strong> : <t t-esc="doc.final_balance" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></div>
                        <!-- <div style="margin-top: 20px; text-align: right; font-size: 18px;"><strong>Solde final : </strong> <span t-field="doc.final_balance" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></div> -->
                    </div>
                </t>
            <!-- </t> -->
        </t>
    </template>

    <template id="report_jouranlCashier">
        <t t-call="index_expense_management.report_jouranl_cashier"/>
    </template>

</odoo>
